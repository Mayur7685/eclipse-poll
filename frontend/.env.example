# Eclipse Poll — Frontend Environment
# Copy this file to .env and fill in your values.
# All VITE_ vars are public and bundled into the frontend build.

# ── Midnight Network (preprod) ────────────────────────────────────────────────
# Deploy the contract via http://localhost:5173/admin/setup
# Then paste the contract address here and restart the dev server.
VITE_MIDNIGHT_MASTER_CONTRACT_ADDRESS=

VITE_MIDNIGHT_INDEXER_URI=https://indexer.preprod.midnight.network/api/v4/graphql
VITE_MIDNIGHT_INDEXER_WS_URI=wss://indexer.preprod.midnight.network/api/v4/graphql/ws
VITE_MIDNIGHT_NODE_URI=https://rpc.preprod.midnight.network
VITE_MIDNIGHT_NETWORK_ID=preprod

# ── Attestation API ───────────────────────────────────────────────────────────
# Local dev:   http://localhost:4000
# Production:  https://your-api.onrender.com
VITE_VERIFIER_URL=http://localhost:4000

# ── Pinata IPFS Gateway ───────────────────────────────────────────────────────
# Get from: https://app.pinata.cloud → Gateways → your gateway subdomain
VITE_PINATA_GATEWAY=https://your-gateway.mypinata.cloud

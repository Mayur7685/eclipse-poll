pragma language_version >= 0.22 && <= 0.23;

import CompactStandardLibrary;
import "schnorr" prefix Schnorr_;

export { Schnorr_SchnorrSignature };

struct SchnorrHashInput3 {
  ann_x: Field;
  ann_y: Field;
  pk_x: Field;
  pk_y: Field;
  msg: Vector<3, Field>;
}

// --- Enums ---
export enum PollType { SIMPLE, RANKED_CHOICE, HIERARCHICAL, APPROVAL }
export enum CredentialType { FREE, ALLOWLIST, SOCIAL_OAUTH }

// --- Nominal Types (domain isolation) ---
export new type UserSecretKey = Bytes<32>;
export new type UserPublicKey = Bytes<32>;
export new type AdminPublicKey = Bytes<32>;
export new type PollId = Bytes<32>;
export new type Nullifier = Bytes<32>;

// --- Community Configuration Struct ---
export struct CommunityOnChainConfig {
  creator: UserPublicKey;
  credType: CredentialType;
  configHash: Bytes<32>;
}

// --- Poll Configuration Struct ---
export struct PollConfig {
  creator: UserPublicKey;
  pollType: PollType;
  credType: CredentialType;
  optionCount: Uint<8>;
  endTime: Uint<64>;
  isClosed: Boolean;
}

// --- Ledger State (Public) ---
export ledger contractAdmin: AdminPublicKey;
// Attestation provider public key — set once via registerAttestationProvider
// Used by credentialed vote circuits to verify Schnorr signatures
export ledger attestationPk: JubjubPoint;

export ledger communities: Map<Bytes<32>, CommunityOnChainConfig>;
export ledger polls: Map<PollId, PollConfig>;
export ledger pollCount: Counter;
export ledger nullifiers: Set<Nullifier>;

// Real-Time Tally Counters
// tallies[pollId][optionIndex] = vote count (simple, ranked, approval polls)
export ledger tallies: Map<PollId, Map<Uint<8>, Counter>>;

// Hierarchical tally: hierarchicalTallies[pollId][parentId][optionIndex] = vote count
// parentId=0 means root layer options
export ledger hierarchicalTallies: Map<PollId, Map<Uint<8>, Map<Uint<8>, Counter>>>;

// Community credentials: communityCredentials[communityId][userNullifier] = Counter (1 = claimed)
// Proves a user has a valid credential for a community without revealing their identity.
// Written once via claimCommunityCredential — persistent, no need to re-verify.
export ledger communityCredentials: Map<Bytes<32>, Map<Nullifier, Counter>>;

// --- Witnesses (Private Inputs) ---
witness getUserSecret(): UserSecretKey;
witness getVoteChoice(): Uint<8>;
witness getRankedWeights(): Vector<8, Uint<8>>;
witness getApprovalChoices(): Vector<8, Boolean>;
// Hierarchical: weights per layer (up to 4 layers × 8 options each)
witness getLayerWeights(): Vector<4, Vector<8, Uint<8>>>;
witness getLayerParents(): Vector<4, Uint<8>>;
// Attestation: Schnorr signature + credential metadata
witness getAttestation(): [Schnorr_SchnorrSignature, CredentialType, PollId];

// --- Pure Helper Circuits ---
pure circuit deriveUserPublicKey(sk: UserSecretKey, secretPin: Uint<16>): UserPublicKey {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "eclipse:voter:pk:v1"),
    sk as Bytes<32>,
    persistentHash<Uint<16>>(secretPin)
  ]) as UserPublicKey;
}

pure circuit deriveAdminPublicKey(sk: UserSecretKey): AdminPublicKey {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "eclipse:admin:pk:v1"),
    sk as Bytes<32>
  ]) as AdminPublicKey;
}

pure circuit computeNullifier(sk: UserSecretKey, pollId: PollId): Nullifier {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "eclipse:nullifier:v1"),
    sk as Bytes<32>,
    pollId as Bytes<32>
  ]) as Nullifier;
}

// --- Constructor ---
constructor() {
  contractAdmin = disclose(deriveAdminPublicKey(getUserSecret()));
}

// --- Admin: Register Attestation Provider ---
export circuit registerAttestationProvider(providerPk: JubjubPoint): [] {
  assert(contractAdmin == deriveAdminPublicKey(getUserSecret()), "Only admin");
  attestationPk = disclose(providerPk);
}

// --- Claim Community Credential ---
// Records a ZK nullifier on-chain proving community membership without revealing identity.
// Eligibility is verified off-chain by the attestation API. On-chain we only store
// the nullifier (derived from userSecretKey + communityId) to prevent double-claiming.
export circuit claimCommunityCredential(communityId: Bytes<32>): [] {
  assert(communities.member(disclose(communityId)), "Community not found");
  const config = communities.lookup(disclose(communityId));
  assert(config.credType != CredentialType.FREE, "Community has no credential requirement");

  const sk = getUserSecret();
  const credNul = computeNullifier(sk, communityId as PollId);

  // Initialize nullifier entry if not exists, then increment
  communityCredentials.lookup(disclose(communityId)).insertDefault(disclose(credNul));
  communityCredentials.lookup(disclose(communityId)).lookup(disclose(credNul)).increment(1);
}


export circuit registerCommunity(
  communityId: Bytes<32>,
  configHash: Bytes<32>,
  credType: CredentialType
): [] {
  assert(!communities.member(disclose(communityId)), "Community already registered");
  const sk = getUserSecret();
  const creatorPk = deriveUserPublicKey(sk, 0 as Uint<16>);

  const comm = CommunityOnChainConfig {
    creator: creatorPk,
    credType: disclose(credType),
    configHash: disclose(configHash)
  };
  communities.insert(disclose(communityId), disclose(comm));
  // Pre-initialize communityCredentials map for this community
  communityCredentials.insertDefault(disclose(communityId));
}

// --- Poll Creation ---
export circuit createPoll(
  pollId: PollId, pollType: PollType,
  credType: CredentialType, optionCount: Uint<8>,
  endTime: Uint<64>
): [] {
  assert(!polls.member(disclose(pollId)), "Poll already exists");
  assert(disclose(optionCount) >= 2, "Need at least 2 options");
  assert(disclose(optionCount) <= 8, "Max 8 options");

  const sk = getUserSecret();
  const creatorPk = deriveUserPublicKey(sk, 0 as Uint<16>);

  const config = PollConfig {
    creator: creatorPk,
    pollType: disclose(pollType),
    credType: disclose(credType),
    optionCount: disclose(optionCount),
    endTime: disclose(endTime),
    isClosed: false
  };
  polls.insert(disclose(pollId), disclose(config));

  // Pre-initialize tally counters for all 8 possible option slots.
  tallies.insertDefault(disclose(pollId));
  for (const i of 0..8) {
    tallies.lookup(disclose(pollId)).insertDefault(i as Uint<8>);
  }

  // Pre-initialize hierarchical tally counters for 4 layers × 8 options.
  // parentId 0..3 represent root and 3 sub-layers.
  hierarchicalTallies.insertDefault(disclose(pollId));
  for (const layer of 0..4) {
    hierarchicalTallies.lookup(disclose(pollId)).insertDefault(layer as Uint<8>);
    for (const opt of 0..8) {
      hierarchicalTallies.lookup(disclose(pollId)).lookup(layer as Uint<8>).insertDefault(opt as Uint<8>);
    }
  }

  pollCount.increment(1);
}

// --- Voting Circuits ---
// Credential enforcement is handled off-chain by the attestation API.
// On-chain we only enforce: poll exists, not closed, correct type, no double-vote.
export circuit castBinaryVote(pollId: PollId): [] {
  const pid = disclose(pollId);
  assert(polls.member(pid), "Poll not found");
  const config = polls.lookup(pid);
  assert(!config.isClosed, "Poll closed");
  assert(config.pollType == PollType.SIMPLE, "Not a simple poll");

  // Anti-double-vote via nullifier
  const sk = getUserSecret();
  const nul = computeNullifier(sk, pollId);
  assert(!nullifiers.member(disclose(nul)), "Already voted");
  nullifiers.insert(disclose(nul));

  // Private vote -> public tally increment
  const choice = getVoteChoice();
  assert(choice < config.optionCount, "Invalid option choice");
  tallies.lookup(pid).lookup(disclose(choice)).increment(1);
}

export circuit castRankedVote(pollId: PollId): [] {
  const pid = disclose(pollId);
  assert(polls.member(pid), "Poll not found");
  const config = polls.lookup(pid);
  assert(!config.isClosed, "Poll closed");
  assert(config.pollType == PollType.RANKED_CHOICE, "Not a ranked poll");

  const sk = getUserSecret();
  const nul = computeNullifier(sk, pollId);
  assert(!nullifiers.member(disclose(nul)), "Already voted");
  nullifiers.insert(disclose(nul));

  // Ranked weights -> Borda scoring
  const weights = getRankedWeights();
  for (const i of 0..8) {
    if ((i as Uint<8>) < config.optionCount) {
      tallies.lookup(pid).lookup(disclose(i as Uint<8>)).increment(
        disclose(weights[i]) as Uint<16>
      );
    }
  }
}

export circuit castApprovalVote(pollId: PollId): [] {
  const pid = disclose(pollId);
  assert(polls.member(pid), "Poll not found");
  const config = polls.lookup(pid);
  assert(!config.isClosed, "Poll closed");
  assert(config.pollType == PollType.APPROVAL, "Not an approval poll");

  const sk = getUserSecret();
  const nul = computeNullifier(sk, pollId);
  assert(!nullifiers.member(disclose(nul)), "Already voted");
  nullifiers.insert(disclose(nul));

  // Each approved option gets +1 — voter can approve any subset
  const choices = getApprovalChoices();
  for (const i of 0..8) {
    if ((i as Uint<8>) < config.optionCount && disclose(choices[i])) {
      tallies.lookup(pid).lookup(disclose(i as Uint<8>)).increment(1);
    }
  }
}

export circuit castHierarchicalVote(pollId: PollId): [] {
  const pid = disclose(pollId);
  assert(polls.member(pid), "Poll not found");
  const config = polls.lookup(pid);
  assert(!config.isClosed, "Poll closed");
  assert(config.pollType == PollType.HIERARCHICAL, "Not a hierarchical poll");

  const sk = getUserSecret();
  const nul = computeNullifier(sk, pollId);
  assert(!nullifiers.member(disclose(nul)), "Already voted");
  nullifiers.insert(disclose(nul));

  // Layer weights: getLayerWeights()[layer][optionIdx] = Borda weight
  // getLayerParents()[layer] = parentId for that layer (0 = root layer)
  const layerWeights = getLayerWeights();
  const layerParents = getLayerParents();

  // Record weights per layer into hierarchicalTallies[pollId][parentId][optionIdx]
  for (const layer of 0..4) {
    const parentId = disclose(layerParents[layer]);
    for (const opt of 0..8) {
      const w = disclose(layerWeights[layer][opt]) as Uint<16>;
      if (w > (0 as Uint<16>)) {
        hierarchicalTallies.lookup(pid).lookup(parentId).lookup(opt as Uint<8>).increment(w);
      }
    }
  }
}

// --- Credentialed Vote Circuits (Schnorr on-chain) ---
// These separate circuits are used for ALLOWLIST and SOCIAL_OAUTH gated polls.
// Separation avoids the Compact compiler limitation of unconditional circuit inlining.

export circuit castCredentialedBinaryVote(pollId: PollId): [] {
  const pid = disclose(pollId);
  assert(polls.member(pid), "Poll not found");
  const config = polls.lookup(pid);
  assert(!config.isClosed, "Poll closed");
  assert(config.pollType == PollType.SIMPLE, "Not a simple poll");
  assert(config.credType != CredentialType.FREE, "Use castBinaryVote for free polls");

  const sk = getUserSecret();
  const nul = computeNullifier(sk, pollId);
  assert(!nullifiers.member(disclose(nul)), "Already voted");
  nullifiers.insert(disclose(nul));

  // Verify Schnorr attestation signature
  const [sig, credType, attPollId] = getAttestation();
  const userPkHash = transientHash<UserPublicKey>(deriveUserPublicKey(sk, 0 as Uint<16>));
  const msg: Vector<3, Field> = [
    disclose(credType) as Field,
    transientHash<PollId>(pollId),
    userPkHash
  ];
  Schnorr_schnorrVerify<3>(msg, sig, attestationPk);

  const choice = getVoteChoice();
  assert(choice < config.optionCount, "Invalid option");
  tallies.lookup(pid).lookup(disclose(choice)).increment(1);
}

export circuit castCredentialedRankedVote(pollId: PollId): [] {
  const pid = disclose(pollId);
  assert(polls.member(pid), "Poll not found");
  const config = polls.lookup(pid);
  assert(!config.isClosed, "Poll closed");
  assert(config.pollType == PollType.RANKED_CHOICE, "Not a ranked poll");
  assert(config.credType != CredentialType.FREE, "Use castRankedVote for free polls");

  const sk = getUserSecret();
  const nul = computeNullifier(sk, pollId);
  assert(!nullifiers.member(disclose(nul)), "Already voted");
  nullifiers.insert(disclose(nul));

  const [sig, credType, attPollId] = getAttestation();
  const userPkHash = transientHash<UserPublicKey>(deriveUserPublicKey(sk, 0 as Uint<16>));
  const msg: Vector<3, Field> = [
    disclose(credType) as Field,
    transientHash<PollId>(pollId),
    userPkHash
  ];
  Schnorr_schnorrVerify<3>(msg, sig, attestationPk);

  const weights = getRankedWeights();
  for (const i of 0..8) {
    if ((i as Uint<8>) < config.optionCount) {
      tallies.lookup(pid).lookup(disclose(i as Uint<8>)).increment(
        disclose(weights[i]) as Uint<16>
      );
    }
  }
}

export circuit closePoll(pollId: PollId): [] {
  const pid = disclose(pollId);
  assert(polls.member(pid), "Poll not found");
  const config = polls.lookup(pid);
  const sk = getUserSecret();
  const callerPk = deriveUserPublicKey(sk, 0 as Uint<16>);
  assert(config.creator == callerPk, "Only creator can close");

  polls.insert(pid, PollConfig {
    creator: config.creator,
    pollType: config.pollType,
    credType: config.credType,
    optionCount: config.optionCount,
    endTime: config.endTime,
    isClosed: disclose(true)
  });
}


# Eclipse Poll — Environment Setup
#
# This monorepo has two services, each with their own .env file:
#
#   attestation-api/.env  ← copy from attestation-api/.env.example
#   frontend/.env         ← copy from frontend/.env.example
#
# Quick setup:
#   cp attestation-api/.env.example attestation-api/.env
#   cp frontend/.env.example frontend/.env
#   # Fill in PINATA_JWT, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
#   # Then run: npm run build

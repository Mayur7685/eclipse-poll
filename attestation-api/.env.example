# Eclipse Poll — Attestation API Environment
# Copy this file to .env and fill in your values.

PORT=4000

# ── OAuth callback base URL ───────────────────────────────────────────────────
# Local dev: use Vite proxy URL so OAuth popups are same-origin
# Production: your Render service URL (e.g. https://eclipse-poll-api.onrender.com)
APP_URL=http://localhost:5173

# ── Attestation signing key ───────────────────────────────────────────────────
# 32-byte hex — keep secret, must be the same across restarts
# Generate: node -e "console.log('0x'+require('crypto').randomBytes(32).toString('hex'))"
ATTESTATION_SECRET_KEY=0x11223344556677889900aabbccddeeff11223344556677889900aabbccddeeff

# ── Pinata IPFS ───────────────────────────────────────────────────────────────
# Community and poll metadata storage
# Get from: https://app.pinata.cloud → API Keys → New Key → Admin
PINATA_JWT=your_pinata_jwt_here

# ── Supabase ──────────────────────────────────────────────────────────────────
# Encrypted vote choice storage (free tier, no credit card)
# 1. Create project at https://supabase.com
# 2. Run in SQL Editor:
#    CREATE TABLE submissions (
#      address TEXT NOT NULL, poll_id TEXT NOT NULL,
#      ciphertext TEXT NOT NULL, saved_at BIGINT NOT NULL,
#      PRIMARY KEY (address, poll_id)
#    );
#    ALTER TABLE submissions ENABLE ROW LEVEL SECURITY;
#    CREATE POLICY "deny_all_public" ON submissions
#      AS RESTRICTIVE TO public USING (false) WITH CHECK (false);
# 3. Get URL and service_role key from: Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Coming Soon (credential gating — not active in v1) ────────────────────────
# These will be needed when identity/eligibility connectors are enabled.
# Leave empty for now — the API falls back gracefully when not set.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_BOT_TOKEN=
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=
# TWITTERAPI_IO_KEY=
# TELEGRAM_BOT_TOKEN=
# FRONTEND_URL=https://your-app.vercel.app

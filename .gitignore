# ─────────────────────────────────────────────────────────────────────────────
# Eclipse Poll Monorepo — Root .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Node ──────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
package-lock.json.bak

# ── Build outputs ─────────────────────────────────────────────────────────────
dist/
build/
out/
.cache/
*.tsbuildinfo

# ── Vite ──────────────────────────────────────────────────────────────────────
*.local
frontend/node_modules/.vite/

# ── SECRETS — NEVER COMMIT THESE ─────────────────────────────────────────────
# Real environment files with actual keys/tokens
.env
.env.local
.env.*.local
.env.development
.env.production
# Keep .env.example files — they are safe documentation with placeholders
!.env.example
!*.env.example

# Seed/key files used by deploy scripts
.deploy-seed
.wallet-seed

# ── Compact compiler generated output ─────────────────────────────────────────
# contract/src/managed/ — regenerated by compiler, contains large binary prover keys
# DO commit: contract/dist/ — TypeScript compiled output needed by frontend
contract/src/managed/
# Allow dist (no secrets, needed for Vercel build)
!contract/dist/

# ── ZK proving assets ─────────────────────────────────────────────────────────
# Must be regenerated by running: npm run sync:zk
frontend/public/zk/

# ── Attestation API local data ────────────────────────────────────────────────
# Local dev JSON stores — production uses Supabase
attestation-api/data/*.json
attestation-api/data/*.db
# Keep the data directory itself
!attestation-api/data/.gitkeep

# ── Deploy outputs ────────────────────────────────────────────────────────────
.deployed-address
eclipse-poll-deploy-state/
scripts/deploy-output/

# ── Midnight tooling ──────────────────────────────────────────────────────────
.midnight/
midnight-data/

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.cursor/
*.code-workspace

# ── Testing ───────────────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Misc ──────────────────────────────────────────────────────────────────────
*.tmp
*.temp
.tmp/

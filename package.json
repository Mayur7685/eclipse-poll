{
  "name": "eclipse-poll-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "contract",
    "attestation-api",
    "frontend"
  ],
  "scripts": {
    "build:contract": "npm run build --workspace=contract",
    "build:api": "npm run build --workspace=attestation-api",
    "build:frontend": "npm run build --workspace=frontend",
    "sync:zk": "node frontend/scripts/sync-zk-assets.mjs",
    "build": "npm run build:contract && npm run sync:zk && npm run build:api && npm run build:frontend",
    "deploy:preprod": "npx tsx scripts/deploy-master.ts",
    "proof-server": "docker run -p 6300:6300 midnightntwrk/proof-server:latest midnight-proof-server -v",
    "build:contract:ts": "npm run build:ts --workspace=contract"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-js": "2.5.0",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/ledger-v8": "8.0.3",
    "@midnight-ntwrk/midnight-js-contracts": "4.0.4",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.0.4",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.0.4",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.0.4",
    "@midnight-ntwrk/midnight-js-network-id": "4.0.4",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.0.4",
    "@midnight-ntwrk/midnight-js-types": "4.0.4",
    "@midnight-ntwrk/wallet-sdk-dust-wallet": "3.0.0",
    "@midnight-ntwrk/wallet-sdk-facade": "3.0.0",
    "@midnight-ntwrk/wallet-sdk-hd": "3.0.1",
    "@midnight-ntwrk/wallet-sdk-shielded": "2.1.0",
    "@midnight-ntwrk/wallet-sdk-unshielded-wallet": "2.1.0",
    "rxjs": "^7.8.2",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.9",
    "tsx": "^4.7.2",
    "typescript": "^5.4.0"
  }
}